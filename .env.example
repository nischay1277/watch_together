# The standalone server reads environment variables, not this file automatically.
PORT=4317
BIND_HOST=0.0.0.0
# Internet deployment: HTTPS public origin of this Node service.
PUBLIC_URL=https://together.example.com
# Supply your own TURN relay for restrictive NATs. Never commit real credentials.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_PASSWORD=
# Optional coturn use-auth-secret alternative to the username/password above.
TURN_SECRET=
# Comma-separated additional allowed browser origins, if needed.
ALLOWED_ORIGINS=
